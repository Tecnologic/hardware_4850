	(text "J601, not from the DC link: the first power-on runs the DC link at 12 V / 0.5 A."
		(exclude_from_sim no)
		(at 15.24 22.86 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "0f367a9d-20d7-5fb6-a2ad-64710e966e86")
	)
	(text "GND (Nucleo, J101 pin 2 = GNDPWR) and GNDA (J102 = INA240 ground) meet only at FB602,"
		(exclude_from_sim no)
		(at 15.24 33.02 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "3a5a2a1b-2f22-5a89-ba88-960887121dbc")
	)
	(text "as FB502 on the old logic board; the power board does not join them."
		(exclude_from_sim no)
		(at 15.24 35.56 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "628588e1-3061-5064-99db-780f9aaeca1e")
	)
	(text "+12V: gate driver supply of the power board (LM5109B VDD, 8..14 V) from a bench supply on"
		(exclude_from_sim no)
		(at 15.24 20.32 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "6d417a20-0c01-53c0-adcc-a4fa234419bd")
	)
	(text "+3.3VA: INA240 supply, NTC pull-ups. From the Nucleo +3V3 (the ADC reference, VDDA)"
		(exclude_from_sim no)
		(at 15.24 27.94 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "83c09e32-abb3-5fdd-9b3d-d822e84f2a70")
	)
	(text "SS34 against reverse polarity, SMAJ15CA clamp. About 20 mA for the gate charge at 32 kHz."
		(exclude_from_sim no)
		(at 15.24 25.4 0)
