    (date "2026-11-06")
    (rev "A")
    (company "UNIMOC")
    (comment 1 "Nucleo adapter: NUCLEO-H743ZI to the legacy 4850 power board")
    (comment 2 "Generated draft, check before layout")
  )
  (lib_symbols)
  (text "Nucleo adapter for the legacy 4850 power board"
    (at 15.24 15.24 0)
    (effects
      (font
        (size 2 2)
        (thickness 0.4) bold
      )
      (justify left bottom)
    )
    (uuid "6374cc37-bdba-532e-b910-435bc788dbdf")
  )
  (text "Bench adapter: a NUCLEO-H743ZI drives the 4850 power board (as ordered 2019-11-20) in place
of the old STM32F730 logic board. The power board is not part of this design.
Board: power-board area = old logic board (J101, J102, H101-H103 at the same place),
extended on one side for the Nucleo morpho sockets. Firmware: unimoc nucleo_h743zi overlay."
    (at 15.24 32.65 0)
    (effects
      (font
        (size 1.27 1.27)
      )
      (justify left bottom)
    )
    (uuid "838b590e-aeb0-54c4-b1e2-1b070fd58e0e")
  )
