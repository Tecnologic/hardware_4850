	(text "R509 + C514: 12 V RC filter, ~340 Hz\nD507: clamps LP2985 input below its 16 V abs max\nR510/R511: LDO on at VDD ~2.0 V (2.3 V max), so VDDA < VDD + 0.3 V while VDD < 1 V (H743 DS 3.5.1)\nCout >= 2.2 uF over temp: C516 here, C606 10u + C605 100n at VDDA (controller sheet)"
		(exclude_from_sim no)
		(at 73.66 60.96 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "269d5d74-2294-4596-9d8c-fc3fb4225798")
	)
